{
  "manifest_version": 3,
  "name": "Send to unflick",
  "version": "1.0.1",
  "description": "Play or queue the current page, link, or media element in unflick — with seamless timestamp handoff.",
  "icons": {
    "16": "icons/16.png",
    "32": "icons/32.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "permissions": [
    "activeTab",
    "contextMenus",
    "scripting"
  ],
  "host_permissions": [
    "http://127.0.0.1:19542/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Send to unflick",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/16.png",
      "32": "icons/32.png",
      "48": "icons/48.png",
      "128": "icons/128.png"
    }
  },
  "commands": {
    "play-current-tab": {
      "suggested_key": {
        "default": "Alt+Shift+U"
      },
      "description": "Play current tab in unflick from current video timestamp"
    },
    "queue-current-tab": {
      "suggested_key": {
        "default": "Alt+Shift+Q"
      },
      "description": "Add current tab to unflick playlist"
    }
  }
}
