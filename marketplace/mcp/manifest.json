{
  "name": "unflick",
  "displayName": "unflick — video player for humans and AI",
  "description": "Drive the unflick video player from any AI agent. Play local files, discs and 30+ streaming-site URLs (YouTube, Bilibili, Twitch, Vimeo…), control playback down to single frames and A-B loops, search what was said and seek to it, describe the frame on screen, generate subtitles locally with whisper.cpp and translate them, find them online, cut clips and GIFs, take screenshots, set chapters and bookmarks, drive a 10-band equalizer, cast to a DLNA television, scan/search a media library, and — with --allow-dev — drive and read the player's own window. 101 tools, 3 live resources, fully headless.",
  "version": "0.14.1",
  "license": "MIT",
  "author": "xiangdong li",
  "homepage": "https://unflick.app",
  "repository": "https://github.com/zhitongblog/unflick",
  "icon": "https://unflick.app/logo.png",
  "categories": [
    "media",
    "video",
    "automation"
  ],
  "keywords": [
    "video",
    "player",
    "mpv",
    "subtitles",
    "whisper",
