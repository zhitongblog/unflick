{
  "productName": "unflick",
  "version": "0.8.1",
  "identifier": "com.unflick.app",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "pnpm dev",
    "beforeBuildCommand": "pnpm build"
  },
  "app": {
    "windows": [
      {
        "title": "unflick",
        "width": 1024,
        "height": 640,
        "minWidth": 640,
        "minHeight": 400,
        "center": true,
        "resizable": true,
        "decorations": false,
        "transparent": false,
        "dragDropEnabled": true,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": {
          "allow": [
            "**"
          ]
        }
      }
    }
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/zhitongblog/unflick/releases/latest/download/latest.json"
      ],
      "dialog": true,
      "pubkey": ""
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "resources": [
      "mpv-dev/libmpv-2.dll",
      "ffmpeg/ffmpeg.exe",
      "yt-dlp/yt-dlp.exe"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "fileAssociations": [
      {
        "ext": [
          "mp4",
          "mkv",
          "avi",
          "mov",
          "wmv",
          "flv",
          "webm",
          "m4v",
          "ts",
          "mpg",
          "mpeg",
          "3gp",
          "ogv"
        ],
        "mimeType": "video/*",
        "description": "Video File"
      },
      {
        "ext": [
          "mp3",
          "flac",
          "wav",
          "ogg",
          "m4a",
          "aac",
          "wma"
        ],
        "mimeType": "audio/*",
        "description": "Audio File"
      }
    ],
    "windows": {
      "wix": {
        "language": "en-US"
      },
      "nsis": {
        "languages": [
          "English",
          "SimpChinese"
        ]
      }
    },
    "macOS": {
      "signingIdentity": "Developer ID Application: xiangdong li (6NQM3XP5RF)",
      "providerShortName": "6NQM3XP5RF",
      "minimumSystemVersion": "11.0",
      "entitlements": "entitlements.plist"
    },
    "category": "Video"
  }
}